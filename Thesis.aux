\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 同一条 O$\to $U 边界在三种设置下的后继落位（真实模型，prefill 1$\times $16，第 2 层）。每条横线为一个线程块自开始到结束的执行区间，纵轴为其所在的 SM。(a) 串行发射，U 均匀分布；(b) 仅该边界启用 PDL，U 不能与 O 共驻，被集中到先腾空的 SM 上，执行时间增加约三成；(c) 全部边界启用 PDL，SM 保持 Q 的档位，U 与 O 共驻并均匀分布。}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:timeline}{{5}{13}{同一条 O$\to $U 边界在三种设置下的后继落位（真实模型，prefill 1$\times $16，第 2 层）。每条横线为一个线程块自开始到结束的执行区间，纵轴为其所在的 SM。(a) 串行发射，U 均匀分布；(b) 仅该边界启用 PDL，U 不能与 O 共驻，被集中到先腾空的 SM 上，执行时间增加约三成；(c) 全部边界启用 PDL，SM 保持 Q 的档位，U 与 O 共驻并均匀分布。}{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces 派发模型对 PDL 后继落位的预测。命中指最拥挤的 SM 上的后继线程块数与实测相等；SM 数误差为预测与实测所占 SM 数之差的中位数 / 90 分位。样本外预测以串行运行中前驱的退出时刻为输入，只含前驱为串行发射的后继}}{14}{table.caption.9}\protected@file@percent }
\newlabel{tab:place}{{3}{14}{派发模型对 PDL 后继落位的预测。命中指最拥挤的 SM 上的后继线程块数与实测相等；SM 数误差为预测与实测所占 SM 数之差的中位数 / 90 分位。样本外预测以串行运行中前驱的退出时刻为输入，只含前驱为串行发射的后继}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 集中放置的代价取决于分布是否均匀。上半部分为探针的 U 型 kernel（128$\times $16 分块，132 个线程块各读一个权重块）在五种落位下的执行时间：均匀地集中只慢 2\,\textmu s以内，不均匀的落位与 PDL 下由运行时给出的落位慢 5–7\,\textmu s；横线为四种前驱退出次序下的取值范围。下半部分为真实方案中 U 阶段在串行发射与仅 O$\to $U 边启用 PDL 时的执行时间。}}{15}{figure.caption.10}\protected@file@percent }
\newlabel{fig:pack}{{6}{15}{集中放置的代价取决于分布是否均匀。上半部分为探针的 U 型 kernel（128$\times $16 分块，132 个线程块各读一个权重块）在五种落位下的执行时间：均匀地集中只慢 2\us 以内，不均匀的落位与 PDL 下由运行时给出的落位慢 5–7\us ；横线为四种前驱退出次序下的取值范围。下半部分为真实方案中 U 阶段在串行发射与仅 O$\to $U 边启用 PDL 时的执行时间。}{figure.caption.10}{}}
